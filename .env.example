# ─── Fashion Store – Environment Variables ───
# Copie este arquivo para .env.local e preencha os valores.

# ── Admin ──
# Senha para acessar /admin/*. Sem ela, o admin fica aberto (com banner de aviso).
ADMIN_PASSWORD=

# ── Google Drive (futuro) ──
# API key para listar pastas do Drive na importação de mídia.
# Não é obrigatório agora — o módulo Drive é só preview.
GOOGLE_DRIVE_API_KEY=

# ── Cloudinary (recomendado para produção) ──
# URL completa do Cloudinary para upload e otimização de mídia.
# Formato: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# ── Vercel Blob Storage (alternativa) ──
# Token para upload de mídia via Vercel Blob.
BLOB_READ_WRITE_TOKEN=
