# ═══════════════════════════════════════════════════
# Fashion Store — Variáveis de Ambiente
# ═══════════════════════════════════════════════════

# ─── Supabase (obrigatório para dados persistentes) ───
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Admin ───
ADMIN_PASSWORD=sua-senha-admin

# ─── Resend (emails automáticos) ───
# Obtenha em: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Remetente — precisa de domínio verificado no Resend
# Enquanto não verificar, use: Fashion Store <onboarding@resend.dev>
# ⚠ onboarding@resend.dev só envia para o email do dono da conta Resend
RESEND_FROM=Fashion Store <pedidos@seudominio.com>

# Email do admin para receber notificações de novos pedidos
ADMIN_EMAIL=seu@email.com

# Nome da loja (usado nos emails)
STORE_NAME=Fashion Store

# ─── Google Drive (importação de imagens) ───
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
GOOGLE_DRIVE_FOLDER_ID=xxxxxxx

# ─── WhatsApp ───
# Já configurado em lib/whatsapp.ts
# Altere WHATSAPP_NUMBER no código se necessário

# ═══════════════════════════════════════════════════
# STATUS DO LOGIN DE CLIENTE
# ═══════════════════════════════════════════════════
# Atualmente o login de cliente usa localStorage (MVP).
# Funciona no mesmo navegador/dispositivo, mas dados
# não persistem entre dispositivos diferentes.
#
# Para login real, configure Supabase Auth:
# 1. Ative Auth no dashboard do Supabase
# 2. Configure email/senha como provider
# 3. As variáveis NEXT_PUBLIC_SUPABASE_* acima são usadas
# 4. Migre contexts/auth-context.tsx para usar Supabase Auth
