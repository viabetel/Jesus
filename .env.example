# ═══════════════════════════════════════════════════
# Fashion Store — Variáveis de Ambiente
# ═══════════════════════════════════════════════════

# ─── Supabase (OBRIGATÓRIO) ───
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# Aliases (se usados no Vercel — aceitos automaticamente):
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=

# ─── Admin ───
ADMIN_PASSWORD=sua-senha-admin

# ─── Resend (emails automáticos) ───
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=Fashion Store <pedidos@seudominio.com>
ADMIN_EMAIL=seu@email.com
STORE_NAME=Fashion Store

# ─── Google Drive (importação de imagens) ───
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
# GOOGLE_DRIVE_FOLDER_ID=xxxxxxx

# ─── Dev (opcional) ───
# Permitir fallback local quando Supabase não estiver disponível
# ALLOW_LOCAL_FALLBACK=true

# ═══════════════════════════════════════════════════
# TABELAS SUPABASE NECESSÁRIAS
# ═══════════════════════════════════════════════════
# products, product_variants, product_media, orders,
# order_items, stock_reservations, customer_favorites
#
# SUPABASE AUTH
# Ativar Auth > Email/Password no dashboard do Supabase
# A tabela auth.users é gerenciada automaticamente
