# =====================================================================
# Fashion Store — variáveis de ambiente
# =====================================================================
# Copie para .env.local em desenvolvimento, e configure no Vercel
# em Settings → Environment Variables.
# =====================================================================

# --- Admin ---
# Senha do admin — OBRIGATÓRIO em produção. Sem ela, /admin retorna 403.
ADMIN_PASSWORD=

# --- Supabase (persistência de pedidos) ---
# Crie um projeto em https://supabase.com e cole abaixo.
# Em SQL Editor, rode o arquivo supabase/schema.sql do projeto.
#
# IMPORTANTE: SUPABASE_SERVICE_KEY é a "service_role key", encontrada em
# Project Settings → API. Ela bypassa RLS e SÓ deve viver no servidor —
# nunca exponha em código de cliente. Não use a anon key.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Mídia (futuras migrações) ---
GOOGLE_DRIVE_API_KEY=
CLOUDINARY_URL=
BLOB_READ_WRITE_TOKEN=
